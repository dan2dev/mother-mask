{
  "name": "mother-mask",
  "private": false,
  "version": "3.41.0",
  "type": "module",
  "description": "Lightweight input mask library for browsers",
  "author": "Danilo Celestino de Castro <dan2dev>",
  "license": "MIT",
  "keywords": [
    "input",
    "mask",
    "form"
  ],
  "main": "./dist/mother-mask.cjs",
  "module": "./dist/mother-mask.mjs",
  "browser": "./dist/mother-mask.umd.js",
  "types": "./dist/mother-mask.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/mother-mask.d.mts",
        "default": "./dist/mother-mask.mjs"
      },
      "require": {
        "types": "./dist/mother-mask.d.cts",
        "default": "./dist/mother-mask.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.mts",
        "default": "./dist/vue.mjs"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/angular.d.mts",
        "default": "./dist/angular.mjs"
      },
      "require": {
        "types": "./dist/angular.d.cts",
        "default": "./dist/angular.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.mts",
        "default": "./dist/svelte.mjs"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/solid.d.mts",
        "default": "./dist/solid.mjs"
      },
      "require": {
        "types": "./dist/solid.d.cts",
        "default": "./dist/solid.cjs"
      }
    },
    "./preact": {
      "import": {
        "types": "./dist/preact.d.mts",
        "default": "./dist/preact.mjs"
      },
      "require": {
        "types": "./dist/preact.d.cts",
        "default": "./dist/preact.cjs"
      }
    },
    "./lit": {
      "import": {
        "types": "./dist/lit.d.mts",
        "default": "./dist/lit.mjs"
      },
      "require": {
        "types": "./dist/lit.d.cts",
        "default": "./dist/lit.cjs"
      }
    },
    "./stencil": {
      "types": "./dist/stencil/index.d.ts",
      "default": "./dist/stencil/index.js"
    },
    "./stencil/mask-input": {
      "types": "./dist/stencil/stencil-mask-input.d.ts",
      "default": "./dist/stencil/stencil-mask-input.js"
    },
    "./stencil/mask-decimal": {
      "types": "./dist/stencil/stencil-mask-decimal.d.ts",
      "default": "./dist/stencil/stencil-mask-decimal.js"
    },
    "./alpine": {
      "import": {
        "types": "./dist/alpine.d.mts",
        "default": "./dist/alpine.mjs"
      },
      "require": {
        "types": "./dist/alpine.d.cts",
        "default": "./dist/alpine.cjs"
      }
    },
    "./web-components": {
      "import": {
        "types": "./dist/web-components.d.mts",
        "default": "./dist/web-components.mjs"
      },
      "require": {
        "types": "./dist/web-components.d.cts",
        "default": "./dist/web-components.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@angular/core": "^19.0.0 || ^20.0.0",
    "alpinejs": "^3.0.0",
    "lit": "^3.0.0",
    "preact": "^10.0.0",
    "react": "^19.2.0",
    "solid-js": "^1.9.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "lit": {
      "optional": true
    },
    "alpinejs": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown && bun run build:stencil",
    "build:stencil": "stencil build --config \"$(cd stencil-src && pwd)/stencil.config.ts\" && cp stencil-src/types/*.d.ts dist/stencil/",
    "build:watch": "tsdown --watch",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist stencil-src/dist stencil-src/.stencil *.tsbuildinfo",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch --coverage",
    "test:package": "bun run build && node --test tests/package.test.mjs",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@angular/common": "^20.3.30",
    "@angular/compiler": "^20.3.30",
    "@angular/core": "^20.3.30",
    "@angular/platform-browser": "^20.3.30",
    "@stencil/core": "^4.44.2",
    "@types/alpinejs": "^3.13.11",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "alpinejs": "^3.17.2",
    "bumpp": "^12.3.0",
    "jsdom": "^29.1.1",
    "lit": "^3.3.3",
    "preact": "^10.29.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.15",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan2dev/mother-mask.git"
  },
  "bugs": {
    "url": "https://github.com/dan2dev/mother-mask/issues"
  },
  "homepage": "https://mother-mask.dan2.dev/"
}
