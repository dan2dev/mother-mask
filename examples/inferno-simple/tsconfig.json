{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    // Left to babel-plugin-inferno (see vite.config.ts) — this only tells
    // tsc to leave JSX untouched for type-checking, not how to compile it.
    // Inferno's own ambient types (imported transitively via 'inferno')
    // declare the global JSX.IntrinsicElements this checks against.
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
