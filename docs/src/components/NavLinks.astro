---
import { NAV, navHref } from '../data/nav'

interface Props {
  current: string
  class: string
}

const { current, class: className } = Astro.props
---

<nav class={className} aria-label="Primary">
  {
    NAV.map((item) => (
      <a href={navHref(item.path)} aria-current={item.slug === current ? 'page' : undefined}>
        {item.label}
      </a>
    ))
  }
</nav>
