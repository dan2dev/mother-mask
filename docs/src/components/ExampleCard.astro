---
// A single live demo card: title, the bind()/bindDecimal() snippet that
// produced it, the bound <input>, and a hint/output area supplied via the
// default slot. Used on examples, regional, decimals, editing, and
// advanced-patterns.
import CodeBlock from './CodeBlock.astro'

interface Props {
  snippet: string
  inputId: string
  ariaLabel?: string
  placeholder?: string
  inputmode?: 'numeric' | 'decimal' | 'tel'
  value?: string
  wide?: boolean
}

const { snippet, inputId, ariaLabel, placeholder, inputmode, value, wide = false } = Astro.props
---

<div class={wide ? 'example example-wide' : 'example'}>
  <h2><slot name="title" /></h2>
  <CodeBlock code={snippet} lang="ts" inline class="snippet" />
  <input id={inputId} aria-label={ariaLabel} placeholder={placeholder} inputmode={inputmode} value={value} />
  <slot />
</div>
