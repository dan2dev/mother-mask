---
import { NAV, navHref, navIndex } from '../data/nav'

interface Props {
  current: string
}

const { current } = Astro.props
const i = navIndex(current)
const prev = NAV[i - 1]
const next = NAV[i + 1]
---

<nav class="page-nav" aria-label="Docs pages">
  {
    prev ? (
      <a class="page-nav-link page-nav-prev" href={navHref(prev.path)}>
        <span class="page-nav-label">&larr; Previous</span>
        <span class="page-nav-title">{prev.label}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next ? (
      <a class="page-nav-link page-nav-next" href={navHref(next.path)}>
        <span class="page-nav-label">Next &rarr;</span>
        <span class="page-nav-title">{next.label}</span>
      </a>
    ) : (
      <span />
    )
  }
</nav>
