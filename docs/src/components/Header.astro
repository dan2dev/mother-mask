---
import NavLinks from './NavLinks.astro'
import { navHref } from '../data/nav'
import { packageVersion } from '../data/package-meta'

interface Props {
  current: string
}

const { current } = Astro.props
---

<header>
  <div class="bar">
    <div class="brand-group">
      <a class="brand" href={navHref('')}>
        <span class="brand-mark" aria-hidden="true">
          <img src={navHref('mother-mask-logo.svg')} alt="" width="40" height="40" />
        </span>
        mother-mask
      </a>
      <span class="version-pill">v{packageVersion}</span>
    </div>
    <nav class="header-nav" aria-label="Featured documentation">
      <a href={navHref('quick-start.html')} aria-current={current === 'quick-start' ? 'page' : undefined}>Get started</a>
      <a href={navHref('examples.html')} aria-current={current === 'examples' ? 'page' : undefined}>Examples</a>
      <a href={navHref('api.html')} aria-current={current === 'api' ? 'page' : undefined}>API</a>
    </nav>
    <details class="mobile-menu" id="mobile-menu">
      <summary>
        <svg class="icon" role="presentation"><use href="#menu-icon"></use></svg>
        <span>Menu</span>
      </summary>
      <NavLinks current={current} class="mobile-menu-nav" />
    </details>
    <div class="header-links">
      <button class="icon-link" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="icon" role="presentation"><use href="#moon-icon"></use></svg>
      </button>
      <a class="icon-link" href="https://github.com/dan2dev/mother-mask" target="_blank" rel="noreferrer" aria-label="GitHub repository">
        <svg class="icon" role="presentation"><use href="#github-icon"></use></svg>
      </a>
      <a class="icon-link" href="https://www.npmjs.com/package/mother-mask" target="_blank" rel="noreferrer" aria-label="npm package">
        <svg class="icon" role="presentation"><use href="#npm-icon"></use></svg>
      </a>
    </div>
  </div>
</header>
