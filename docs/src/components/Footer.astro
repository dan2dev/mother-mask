---
import { navHref } from '../data/nav'
---

<footer>
  <div class="footer-brand">
    <a class="brand-mark footer-brand-mark" href={navHref('')} aria-label="mother-mask home">
      <img src={navHref('mother-mask-logo.svg')} alt="" width="40" height="40" loading="lazy" />
    </a>
    <div class="footer-brand-copy">
      <span class="footer-brand-name">mother-mask</span>
      <p>
        Crafted with care by &nbsp;
        <a class="footer-author" href="https://github.com/dan2dev" target="_blank" rel="noreferrer">
          dan2dev <span aria-hidden="true">↗</span>
        </a>
      </p>
    </div>
  </div>

  <div class="footer-columns">
    <div class="footer-column">
      <span class="footer-column-label">Resources</span>
      <a href={navHref('quick-start.html')}>Quick start</a>
      <a href={navHref('examples.html')}>Examples</a>
      <a href={navHref('api.html')}>API reference</a>
    </div>

    <div class="footer-column">
      <span class="footer-column-label">Community</span>
      <a href="https://github.com/dan2dev/mother-mask" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://github.com/dan2dev/mother-mask/issues" target="_blank" rel="noreferrer">Issues</a>
    </div>

    <div class="footer-column">
      <span class="footer-column-label">Support</span>
      <a href="https://www.npmjs.com/package/mother-mask" target="_blank" rel="noreferrer">npm</a>
      <a href="https://github.com/dan2dev/mother-mask/blob/main/LICENSE" target="_blank" rel="noreferrer">License (MIT)</a>
    </div>
  </div>
</footer>
