---
import Layout from '../layouts/Layout.astro'
import CodeBlock from '../components/CodeBlock.astro'
import ExampleCard from '../components/ExampleCard.astro'

const tokenDefsSnippet = `const uppercaseLetter = {
  match: /[a-z]/i,
  transform: (char: string) => char.toUpperCase(),
}
const uppercaseAlphanumeric = {
  match: /[a-z0-9]/i,
  transform: (char: string) => char.toUpperCase(),
}`

const rawSnippet = `bind(input, '999.999.999-99', value => {
  document.getElementById('ex-raw-masked')!.textContent = value;
  document.getElementById('ex-raw-digits')!.textContent = value.replace(/\\D/g, '')
})`
---

<Layout
  current="examples"
  title="Examples — mother-mask docs"
  description="Live mother-mask examples: CPF, CNPJ, CEP, phone, date, time, license plates, credit cards, and currency input masks."
>
  <section id="examples">
    <h1 class="page-title">Examples</h1>
    <p class="section-sub">
      Every field below is live. “Complete” means the expected number of characters is present, not that a date, checksum, card, or identifier is
      valid. Validate those separately in your application.
    </p>
    <p>Examples that normalize case share these local token definitions:</p>
    <CodeBlock code={tokenDefsSnippet} lang="ts" />

    <div class="examples-grid">
      <ExampleCard snippet="bind(input, '999.999.999-99')" inputId="ex-cpf" placeholder="000.000.000-00" inputmode="numeric">
        <Fragment slot="title">CPF</Fragment>
        <span class="hint" id="ex-cpf-hint">11 digits</span>
      </ExampleCard>

      <ExampleCard
        snippet="bind(input, 'AA.AAA.AAA/AAAA-99', { tokens: { A: uppercaseAlphanumeric } })"
        inputId="ex-cnpj"
        placeholder="AA.AAA.AAA/AAAA-00"
      >
        <Fragment slot="title">CNPJ (alphanumeric)</Fragment>
        <span class="hint" id="ex-cnpj-hint">12 alphanumeric + 2 digits</span>
      </ExampleCard>

      <ExampleCard snippet="bind(input, '99999-999')" inputId="ex-cep" placeholder="00000-000" inputmode="numeric">
        <Fragment slot="title">CEP</Fragment>
        <span class="hint" id="ex-cep-hint">8 digits</span>
      </ExampleCard>

      <ExampleCard snippet="bind(input, ['(99) 9999-9999', '(99) 99999-9999'])" inputId="ex-phone" placeholder="(00) 00000-0000" inputmode="tel">
        <Fragment slot="title">Phone — array mask</Fragment>
        <span class="hint" id="ex-phone-hint">10 or 11 digits — mask switches automatically</span>
      </ExampleCard>

      <ExampleCard snippet="bind(input, '99/99/9999')" inputId="ex-date-seg" placeholder="DD/MM/YYYY" inputmode="numeric" value="25/12/2025">
        <Fragment slot="title">Date — segmented (default)</Fragment>
        <span class="hint">select "12" and retype — day and year stay put</span>
      </ExampleCard>

      <ExampleCard
        snippet="bind(input, '99/99/9999', { segmented: false })"
        inputId="ex-date-flat"
        placeholder="DD/MM/YYYY"
        inputmode="numeric"
        value="25/12/2025"
      >
        <Fragment slot="title">Date — flat (<code>segmented: false</code>)</Fragment>
        <span class="hint">same edit here pulls the year forward</span>
      </ExampleCard>

      <ExampleCard snippet="bind(input, '99/99/9999')" inputId="ex-date-eager" placeholder="DD/MM/YYYY" inputmode="numeric">
        <Fragment slot="title">Date — eager (default)</Fragment>
        <span class="hint">type "25" — the "/" appears before you type it</span>
      </ExampleCard>

      <ExampleCard snippet="bind(input, '99/99/9999', { eager: false })" inputId="ex-date-not-eager" placeholder="DD/MM/YYYY" inputmode="numeric">
        <Fragment slot="title">Date — not eager (<code>eager: false</code>)</Fragment>
        <span class="hint">type "25" — the "/" waits for the next digit</span>
      </ExampleCard>

      <ExampleCard
        snippet="bind(input, '9{1,2}/9{1,2}/9{4}')"
        inputId="ex-date-flex"
        placeholder="D/M/YYYY"
        inputmode="numeric"
      >
        <Fragment slot="title">Date — one or two digits (<code>{'{'}min,max{'}'}</code>)</Fragment>
        <span class="hint">type "3/4/1986" — the "/" you type commits the short segment</span>
      </ExampleCard>

      <ExampleCard snippet="bind(input, '99:99')" inputId="ex-time" placeholder="HH:MM" inputmode="numeric" value="14:30">
        <Fragment slot="title">Time</Fragment>
        <span class="hint">simple HH:MM bind mask</span>
      </ExampleCard>

      <ExampleCard snippet="bind(input, 'ZZZ-9999', { segmented: false, tokens: { Z: uppercaseLetter } })" inputId="ex-plate" placeholder="ABC-1234">
        <Fragment slot="title">License plate</Fragment>
        <span class="hint">letters then digits</span>
      </ExampleCard>

      <ExampleCard snippet="bind(input, 'ZZZ-9Z99', { tokens: { Z: uppercaseLetter } })" inputId="ex-mercosul" placeholder="ABC-1D23">
        <Fragment slot="title">Mercosul plate</Fragment>
        <span class="hint">letter/digit mixed pattern</span>
      </ExampleCard>

      <ExampleCard
        snippet="bind(input, ['9999 999999 99999', '9999 9999 9999 9999'])"
        inputId="ex-card"
        placeholder="0000 0000 0000 0000"
        inputmode="numeric"
      >
        <Fragment slot="title">Credit card — array mask</Fragment>
        <span class="hint" id="ex-card-hint">15 or 16 digits; length selects the layout</span>
      </ExampleCard>

      <ExampleCard snippet="bindDecimal(input, { decimalPlaces: 2, prefix: '$' })" inputId="ex-usd" placeholder="$0.00" inputmode="decimal">
        <Fragment slot="title">Currency (USD-style)</Fragment>
      </ExampleCard>

      <ExampleCard
        snippet="bindDecimal(input, { decimalPlaces: 2, separator: '.', decimalSeparator: ',', suffix: ' €' })"
        inputId="ex-eur"
        placeholder="0,00 €"
        inputmode="decimal"
      >
        <Fragment slot="title">Currency (EUR-style)</Fragment>
        <span class="hint">"." also opens the fraction</span>
      </ExampleCard>

      <ExampleCard snippet="bindDecimal(input, { decimalPlaces: 0, suffix: ' units' })" inputId="ex-qty" placeholder="0 units" inputmode="numeric">
        <Fragment slot="title">Whole numbers</Fragment>
      </ExampleCard>

      <ExampleCard
        snippet="bindDecimal(input, { decimalPlaces: 2, prefix: '$', allowNegative: true })"
        inputId="ex-balance"
        placeholder="$0.00"
        inputmode="decimal"
      >
        <Fragment slot="title">Negative values</Fragment>
        <span class="hint">type "-" anywhere to flip the sign</span>
      </ExampleCard>

      <ExampleCard snippet={rawSnippet} inputId="ex-raw" placeholder="000.000.000-00" inputmode="numeric" wide>
        <Fragment slot="title">Masked value vs. raw value</Fragment>
        <div class="raw-outputs">
          <div>
            <span class="hint">masked</span>
            <output id="ex-raw-masked">—</output>
          </div>
          <div>
            <span class="hint">raw digits</span>
            <output id="ex-raw-digits">—</output>
          </div>
        </div>
      </ExampleCard>
    </div>
  </section>
</Layout>

<script src="../scripts/demos/examples.ts"></script>
