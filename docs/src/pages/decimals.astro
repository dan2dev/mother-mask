---
import Layout from '../layouts/Layout.astro'
import CodeBlock from '../components/CodeBlock.astro'
import ExampleCard from '../components/ExampleCard.astro'

const snippet = `import { bindDecimal, formatDecimalValue, unmaskDecimal } from 'mother-mask'

const options = {
  decimalPlaces: 2,
  separator: '.',
  decimalSeparator: ',',
  suffix: ' €',
}

input.value = formatDecimalValue(1234.5, options) // '1.234,50 €'
bindDecimal(input, {
  ...options,
  onChange: (value, numericValue) => console.log(value, numericValue),
})
unmaskDecimal('1.234,50 €', options) // 1234.5`

const callbackSnippet = "bindDecimal(input, { suffix: ' kg', onChange: (masked, numeric) => updateOutputs(masked, numeric) })"
---

<Layout
  current="decimals"
  title="Decimal formatting — mother-mask docs"
  description="Format currency, quantities, and decimals with bindDecimal — prefixes, suffixes, locale separators, and fixed widths."
>
  <section id="decimals">
    <h1 class="page-title">Decimal formatting</h1>
    <p class="section-sub">
      The integer part grows freely by default. The fraction is optional and unlimited until <code>decimalPlaces</code> is set. Use text inputs
      with <code>inputmode="decimal"</code>.
    </p>

    <div class="examples-grid">
      <ExampleCard snippet="bindDecimal(input)" inputId="ex-decimal-free" ariaLabel="Optional unlimited decimal fraction" inputmode="decimal" placeholder="1,234.56789">
        <Fragment slot="title">Optional fraction (default)</Fragment>
        <span class="hint">Type 1234, then add .56789; no fixed precision is imposed.</span>
      </ExampleCard>

      <ExampleCard
        snippet="bindDecimal(input, { decimalPlaces: 2, prefix: '$' })"
        inputId="ex-decimal-usd"
        ariaLabel="US dollar amount"
        inputmode="decimal"
        value="$1,234.50"
        placeholder="$0.00"
      >
        <Fragment slot="title">US dollars</Fragment>
        <span class="hint">Fixed cents, comma grouping, and an inert prefix.</span>
      </ExampleCard>

      <ExampleCard
        snippet="bindDecimal(input, { decimalPlaces: 2, separator: '.', decimalSeparator: ',', prefix: 'R$ ' })"
        inputId="ex-decimal-brl"
        ariaLabel="Brazilian real amount"
        inputmode="decimal"
        value="R$ 1.234,50"
        placeholder="R$ 0,00"
      >
        <Fragment slot="title">Brazilian real</Fragment>
        <span class="hint">Period grouping and a comma decimal separator.</span>
      </ExampleCard>

      <ExampleCard
        snippet="bindDecimal(input, { decimalPlaces: 2, separator: '.', decimalSeparator: ',', suffix: ' €' })"
        inputId="ex-decimal-eur"
        ariaLabel="Euro amount"
        inputmode="decimal"
        value="1.234,50 €"
        placeholder="0,00 €"
      >
        <Fragment slot="title">Euros</Fragment>
        <span class="hint">Type a comma to open the fraction; the suffix stays inert.</span>
      </ExampleCard>

      <ExampleCard
        snippet="bindDecimal(input, { decimalPlaces: 0, suffix: ' units' })"
        inputId="ex-decimal-units"
        ariaLabel="Whole number quantity"
        inputmode="numeric"
        value="1,250 units"
        placeholder="0 units"
      >
        <Fragment slot="title">Whole quantities</Fragment>
        <span class="hint">No decimal segment; grouping grows with the integer.</span>
      </ExampleCard>

      <ExampleCard
        snippet="bindDecimal(input, { decimalPlaces: 2, prefix: '$', allowNegative: true })"
        inputId="ex-decimal-negative"
        ariaLabel="Signed account balance"
        inputmode="decimal"
        value="-$1,234.50"
        placeholder="$0.00"
      >
        <Fragment slot="title">Signed balances</Fragment>
        <span class="hint">Type “-” anywhere to go negative, “+” anywhere to go positive.</span>
      </ExampleCard>

      <ExampleCard
        snippet="bindDecimal(input, { decimalPlaces: 2, segmented: false })"
        inputId="ex-decimal-plain"
        ariaLabel="Ungrouped decimal value"
        inputmode="decimal"
        value="1234567.89"
        placeholder="0.00"
      >
        <Fragment slot="title">No thousands grouping</Fragment>
        <span class="hint">Useful when the display should stay close to a storage value.</span>
      </ExampleCard>

      <ExampleCard
        snippet="bindDecimal(input, { numberPlaces: 2, decimalPlaces: 2 })"
        inputId="ex-decimal-width"
        ariaLabel="Fixed width decimal"
        inputmode="decimal"
        placeholder="07.30"
      >
        <Fragment slot="title">Fixed integer and fraction widths</Fragment>
        <span class="hint">Paste 7.3 to see 07.30; each part is capped at two digits.</span>
      </ExampleCard>

      <ExampleCard
        snippet={callbackSnippet}
        inputId="ex-decimal-callback"
        ariaLabel="Weight with masked and numeric outputs"
        inputmode="decimal"
        value="2.5 kg"
        placeholder="0 kg"
        wide
      >
        <Fragment slot="title">Masked value and numeric callback</Fragment>
        <div class="raw-outputs">
          <div>
            <span class="hint">masked string</span>
            <output id="ex-decimal-masked">2.5 kg</output>
          </div>
          <div>
            <span class="hint">numeric value</span>
            <output id="ex-decimal-numeric">2.5</output>
          </div>
        </div>
      </ExampleCard>
    </div>

    <p>
      Set <code>decimalPlaces: 2</code> for fixed, zero-padded currency decimals, or <code>0</code> for integers only. <code>numberPlaces</code> pads
      and caps the integer part. Here <code>segmented</code> controls thousands grouping; it does not mean independent pattern fields.
    </p>
    <p>
      Prefixes and suffixes are fixed display text, excluded from numeric parsing even when they contain digits or a decimal separator. Typing
      inside a prefix inserts at the start of the number; typing inside a suffix inserts at the end. Use the same locale and affix options when
      formatting and parsing.
    </p>

    <h2>Formatting without an input</h2>
    <p>
      Use the pure helpers for initial values, server-rendered output, and programmatic updates. Pass the same options to formatting and parsing.
    </p>
    <CodeBlock code={snippet} lang="ts" />
  </section>
</Layout>

<script src="../scripts/demos/decimals.ts"></script>
