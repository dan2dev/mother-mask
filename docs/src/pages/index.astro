---
import Layout from '../layouts/Layout.astro'
import InstallBox from '../components/InstallBox.astro'
import CodeBlock from '../components/CodeBlock.astro'
import { navHref } from '../data/nav'
import { bundleArtifact, bundleGzipBytes, bundleGzipSize } from '../data/package-meta'

const playgroundCode = `import { bind, bindDecimal } from 'mother-mask'

bind(phone, '(99) 99999-9999')
bind(card, '9999 9999 9999 9999')
bind(date, '99/99/9999')
bindDecimal(amount, {
  prefix: 'R$ ',
  separator: '.',
  decimalSeparator: ',',
  decimalPlaces: 2,
})`
---

<Layout
  current="index"
  title="mother-mask — TypeScript input masks for browser forms"
  description="Zero-dependency TypeScript input masks with custom tokens, Unicode, dynamic patterns and decimal formatting. Documentation, API reference and live examples."
  keywords="input mask, input masking, TypeScript input mask, JavaScript input mask, browser form masks, currency mask, phone mask, CPF mask, CNPJ mask"
>
  <section class="hero" id="top">
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="hero-copy">
      <span class="pill">
        <svg class="icon" role="presentation"><use href="#sparkle-icon"></use></svg>
        Zero dependencies. Fully typed.
      </span>
      <h1>Input masks,<br /><span class="grad-text">without the rough edges.</span></h1>
      <p>
        A tiny, framework-agnostic TypeScript library that makes formatted inputs feel natural—to type, paste, edit, and build.
      </p>
      <div class="hero-actions">
        <a class="button-link" href={navHref('quick-start.html')}>
          Get started
          <svg class="icon" role="presentation"><use href="#arrow-right-icon"></use></svg>
        </a>
        <a class="text-link" href="https://github.com/dan2dev/mother-mask" target="_blank" rel="noreferrer">
          <svg class="icon" role="presentation"><use href="#github-icon"></use></svg>
          View on GitHub
        </a>
      </div>
      <InstallBox />
    </div>

    <div class="hero-visual" aria-label="mother-mask logo illustration">
      <div class="hero-orbit" aria-hidden="true">
        <span class="orbit-chip orbit-chip-top"><code>(99) 99999-9999</code></span>
        <span class="orbit-chip orbit-chip-bottom"><span class="status-dot"></span> paste-safe</span>
      </div>
      <div class="hero-mark-wrap">
        <img src={navHref('mother-mask-logo.svg')} alt="" width="520" height="520" fetchpriority="high" />
      </div>
      <span class="spark-grid" aria-hidden="true"></span>
    </div>
  </section>

  <section class="feature-strip" aria-label="Why mother-mask">
    <article class="feature">
      <div class="icon-badge icon-badge-orange">
        <svg class="icon" role="presentation"><use href="#bolt-icon"></use></svg>
      </div>
      <div>
        <h2>Tiny &amp; fast</h2>
        <p title={`${bundleArtifact}: ${bundleGzipBytes.toLocaleString('en-US')} bytes gzipped`}><strong>{bundleGzipSize}</strong> min+gz, with no runtime dependencies.</p>
      </div>
    </article>

    <article class="feature">
      <div class="icon-badge icon-badge-purple">
        <svg class="icon" role="presentation"><use href="#code-icon"></use></svg>
      </div>
      <div><h2>Framework agnostic</h2><p>Works with vanilla JS, React, Vue, and more.</p></div>
    </article>

    <article class="feature">
      <div class="icon-badge icon-badge-teal">
        <svg class="icon" role="presentation"><use href="#puzzle-icon"></use></svg>
      </div>
      <div><h2>Flexible by design</h2><p>Compose patterns, tokens, transforms, and locales.</p></div>
    </article>

    <article class="feature">
      <div class="icon-badge icon-badge-pink">
        <svg class="icon" role="presentation"><use href="#heart-icon"></use></svg>
      </div>
      <div><h2>Editing that feels right</h2><p>Built for typing, pasting, selection, and replacement.</p></div>
    </article>
  </section>

  <section class="playground-section" id="overview" aria-labelledby="playground-heading">
    <div class="section-heading-row">
      <div>
        <span class="section-kicker">Live playground</span>
        <h2 id="playground-heading">Try the details that make the difference.</h2>
      </div>
      <p>Every field is live. Replace a selection, paste a messy value, or move the caret and keep typing.</p>
    </div>

    <div class="playground-shell">
      <div class="playground-fields">
        <label class="playground-field">
          <svg class="icon" role="presentation"><use href="#phone-icon"></use></svg>
          <span>Phone number</span>
          <input id="hero-phone" aria-describedby="hero-phone-hint" inputmode="tel" value="(11) 98765-4321" />
          <small id="hero-phone-hint">11 digits</small>
        </label>
        <label class="playground-field">
          <svg class="icon" role="presentation"><use href="#card-icon"></use></svg>
          <span>Card number</span>
          <input id="hero-card" inputmode="numeric" value="1234 5678 9012 3456" />
          <small>16 digits</small>
        </label>
        <label class="playground-field">
          <svg class="icon" role="presentation"><use href="#calendar-icon"></use></svg>
          <span>Date</span>
          <input id="hero-date" inputmode="numeric" value="28/08/2026" />
          <small>DD / MM / YYYY</small>
        </label>
        <label class="playground-field">
          <svg class="icon" role="presentation"><use href="#currency-icon"></use></svg>
          <span>Currency</span>
          <input id="hero-currency" inputmode="decimal" value="R$ 1.234,56" />
          <small>Brazilian real</small>
        </label>
        <a class="more-examples" href={navHref('examples.html')}>
          Explore every example
          <svg class="icon" role="presentation"><use href="#arrow-right-icon"></use></svg>
        </a>
      </div>

      <div class="playground-code-window">
        <div class="window-toolbar">
          <span class="demo-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>TypeScript</span>
        </div>
        <CodeBlock code={playgroundCode} lang="ts" />
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="cta-banner-inner">
      <div class="cta-banner-copy">
        <span class="section-kicker">One command away</span>
        <h2>Make every keystroke feel considered.</h2>
        <p>Install mother-mask and bring clarity to your forms.</p>
      </div>
      <InstallBox />
    </div>
  </section>
</Layout>

<script src="../scripts/demos/index.ts"></script>
