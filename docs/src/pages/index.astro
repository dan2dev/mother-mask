---
import Layout from '../layouts/Layout.astro'
import InstallBox from '../components/InstallBox.astro'
import { navHref } from '../data/nav'
---

<Layout
  current="index"
  title="mother-mask — TypeScript input masks for browser forms"
  description="Zero-dependency TypeScript input masks with custom tokens, Unicode, dynamic patterns and decimal formatting. Documentation, API reference and live examples."
  keywords="input mask, input masking, TypeScript input mask, JavaScript input mask, browser form masks, currency mask, phone mask, CPF mask, CNPJ mask"
>
  <section class="hero" id="top">
    <div class="blob-field" aria-hidden="true"></div>

    <div class="hero-copy">
      <span class="pill">
        <svg class="icon" role="presentation"><use href="#sparkle-icon"></use></svg>
        The elegant masking library
      </span>
      <h1>TypeScript input masks with <span class="grad-text">care and precision</span>.</h1>
      <p>mother-mask is a lightweight, framework-agnostic TypeScript library for input masking with a beautiful developer experience.</p>
      <div class="hero-actions">
        <a class="button-link" href={navHref('quick-start.html')}>Get started</a>
        <a class="text-link" href="https://github.com/dan2dev/mother-mask" target="_blank" rel="noreferrer">View on GitHub</a>
      </div>
      <InstallBox />
    </div>

    <div class="hero-demo" aria-label="Live mask preview">
      <div class="demo-toolbar">
        <span class="demo-dots" aria-hidden="true"><span></span><span></span><span></span></span>
        <code>bind()</code>
      </div>
      <label class="hero-field">
        <span>Phone</span>
        <input id="hero-phone" placeholder="(000) 000-0000" inputmode="tel" value="(555) 123-4567" />
      </label>
      <div class="hero-code">
        <code>bind(input, '(999) 999-9999')</code>
      </div>
      <div class="hero-demo-footer">
        <span id="hero-phone-hint">10 digits</span>
        <span>paste-safe</span>
      </div>
    </div>
  </section>

  <section id="overview" aria-labelledby="overview-heading">
    <h2 id="overview-heading">Lightweight JavaScript input masking</h2>
    <p class="section-sub">
      mother-mask formats form fields as people type, paste, select, and replace text. Use it in plain browser apps or alongside any UI framework
      because the package only needs an <code>HTMLInputElement</code>.
    </p>

    <div class="feature-grid">
      <div class="feature">
        <div class="icon-badge icon-badge-orange">
          <svg class="icon" role="presentation"><use href="#bolt-icon"></use></svg>
        </div>
        <h3>Tiny &amp; fast</h3>
        <p>Zero runtime dependencies, a few KB min+gz, and no framework to load first.</p>
      </div>

      <div class="feature">
        <div class="icon-badge icon-badge-purple">
          <svg class="icon" role="presentation"><use href="#code-icon"></use></svg>
        </div>
        <h3>Framework agnostic</h3>
        <p>Works anywhere an <code>HTMLInputElement</code> exists: vanilla JS, React, Vue, and more.</p>
      </div>

      <div class="feature">
        <div class="icon-badge icon-badge-teal">
          <svg class="icon" role="presentation"><use href="#puzzle-icon"></use></svg>
        </div>
        <h3>Flexible patterns</h3>
        <p>
          Phone, date, CPF, CNPJ, CEP, SSN, IBAN, VAT ID, license plate, and credit card masks — or define custom tokens, transforms, and
          dynamic patterns with <code>resolveMask</code>.
        </p>
      </div>

      <div class="feature">
        <div class="icon-badge icon-badge-pink">
          <svg class="icon" role="presentation"><use href="#heart-icon"></use></svg>
        </div>
        <h3>Developer friendly</h3>
        <p>A small, fully typed API — <code>bind()</code> and <code>bindDecimal()</code> — plus pure formatting helpers for any framework.</p>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="cta-banner-inner">
      <div class="cta-banner-copy">
        <h2>Ready to craft <span class="grad-text">beautiful</span> inputs?</h2>
        <p>Install now and bring clarity and intelligence to your forms.</p>
      </div>
      <InstallBox />
    </div>
  </section>
</Layout>

<script src="../scripts/demos/index.ts"></script>
